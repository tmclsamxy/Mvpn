{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mvpn",
  "version": "0.2.0",
  "identifier": "com.mvpn.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mvpn",
        "width": 1020,
        "height": 680,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
